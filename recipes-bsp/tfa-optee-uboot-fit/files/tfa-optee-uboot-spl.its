/dts-v1/;

/ {
    description = "TFA + OP-TEE + U-Boot FIT Image for SPL";
    #address-cells = <1>;

    images {

        /* ------------------------ */
        /*  BL31 (ARM Trusted FW)   */
        /* ------------------------ */
        tfa {
            description = "ARM Trusted Firmware";
            data = /incbin/("bl31.bin");
            type = "firmware";
            arch = "arm64";
            os = "arm-trusted-firmware";
            compression = "none";
            load = <0xBC300000>;
            entry = <0xBC300000>;

            hash-1 {
                algo = "sha256";
            };
        };

        /* ------------------------ */
        /*  BL32 (OP-TEE)           */
        /* ------------------------ */
        optee {
            description = "OP-TEE Secure OS";
            data = /incbin/("tee-raw.bin");
            type = "tee";
            arch = "arm64";
            os = "tee";
            compression = "none";
            load = <0xBC600000>;
            entry = <0xBC600000>;

            hash-1 {
                algo = "sha256";
            };
        };
	 /* ------------------------ */
        /*  TZ_AC_CFG           */
        /* ------------------------ */
        tz_ac_config {
            description = "TZ AC Config";
            data = /incbin/("tz_ac_config.bin");
            type = "tee";
            arch = "arm64";
            compression = "none";
            load = <0xBC000000>;
            entry = <0xBC000000>;

            hash-1 {
                algo = "sha256";
            };
        };
        /* ------------------------ */
        /*  BL33 (U-Boot)           */
        /* ------------------------ */
        uboot {
            description = "U-Boot Bootloader";
            data = /incbin/("u-boot.bin");
            type = "standalone";
            arch = "arm64";
            os = "u-boot";
            compression = "none";
            load = <0xd8d00000>;
            entry = <0xd8d00000>;

            hash-1 {
                algo = "sha256";
            };
        };
    };

    /* ---------------------------- */
    /*  CONFIGURATION               */
    /* ---------------------------- */
    configurations {
        default = "post-ddr";

        post-ddr {
            description = "post-ddr";

            firmware = "tfa";

            loadables = "uboot", "optee", "tz_ac_config";

            signature-1 {
                algo = "sha256,rsa2048";
                key-name-hint = "dev";
                sign-images = "firmware", "loadables";
            };
        };
    };
};
