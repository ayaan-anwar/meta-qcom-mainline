From a5b21b56a598d4484fdb5027c3d5378c0998686f Mon Sep 17 00:00:00 2001
From: Mohd Ayaan Anwar <mohd.anwar@oss.qualcomm.com>
Date: Wed, 23 Sep 2026 00:33:35 +0530
Subject: [PATCH 18/18] PENDING: arm64: dts: qcom: add Ethernet support for
 Nord

Describe both Nord 10-Gbps Ethernet controllers, including their XPCS and
SerDes blocks, clocks, resets, power domains, SMMU streams and DMA queues.

Enable both ports on Nord Ride SX in fixed-link USXGMII 10-Gbps mode for
connection to the onboard firmware driven Ethernet switch.

Upstream-Status: Pending
Signed-off-by: Mohd Ayaan Anwar <mohd.anwar@oss.qualcomm.com>

diff --git a/arch/arm64/boot/dts/qcom/nord-embedded.dtsi b/arch/arm64/boot/dts/qcom/nord-embedded.dtsi
index 14af29801c7d..34aa9ba41432 100644
--- a/arch/arm64/boot/dts/qcom/nord-embedded.dtsi
+++ b/arch/arm64/boot/dts/qcom/nord-embedded.dtsi
@@ -1590,6 +1590,336 @@ mmss_noc: interconnect@1780000 {
 		qcom,bcm-voters = <&apps_bcm_voter>;
 	};
 
+	ethernet0: ethernet@1a00000 {
+		compatible = "qcom,nord-ethqos";
+		reg = <0x0 0x01a00000 0x0 0x14000>,
+		      <0x0 0x01a7f000 0x0 0x1000>;
+		reg-names = "stmmaceth", "rgmii";
+		interrupts = <GIC_SPI 821 IRQ_TYPE_LEVEL_HIGH>,
+			     <GIC_SPI 704 IRQ_TYPE_LEVEL_HIGH>;
+		interrupt-names = "macirq", "eth_lpi";
+		clocks = <&segcc SE_GCC_EMAC0_AXI_CLK>,
+			 <&segcc SE_GCC_EMAC0_CNOC_APB_CLK>,
+			 <&segcc SE_GCC_EMAC0_PTP_CLK>,
+			 <&segcc SE_GCC_EMAC0_PHY_AUX_CLK>,
+			 <&segcc SE_GCC_EEE_EMAC0_CLK>;
+		clock-names = "stmmaceth", "pclk", "ptp_ref", "phyaux", "eee";
+		resets = <&segcc SE_GCC_EMAC0_BCR>;
+		power-domains = <&segcc SE_GCC_EMAC0_GDSC>;
+		iommus = <&apps_smmu_2 0x1201 0x2>,
+			 <&apps_smmu_2 0x1202 0x0>,
+			 <&apps_smmu_2 0x1203 0x2>,
+			 <&apps_smmu_2 0x1204 0x0>,
+			 <&apps_smmu_2 0x1205 0x2>,
+			 <&apps_smmu_2 0x1206 0x0>,
+			 <&apps_smmu_2 0x1207 0x2>,
+			 <&apps_smmu_2 0x1208 0x0>,
+			 <&apps_smmu_2 0x1209 0x0>,
+			 <&apps_smmu_2 0x120a 0x0>;
+		pcs-handle = <&xpcs0>;
+		phys = <&serdes0>;
+		phy-names = "serdes";
+		dma-coherent;
+		snps,tso;
+		snps,pbl = <16>;
+		rx-fifo-depth = <98304>;
+		tx-fifo-depth = <98304>;
+		snps,axi-config = <&emac0_axi_setup>;
+		snps,mtl-rx-config = <&emac0_mtl_rx>;
+		snps,mtl-tx-config = <&emac0_mtl_tx>;
+		status = "disabled";
+
+		emac0_axi_setup: stmmac-axi-config {
+			snps,wr_osr_lmt = <16>;
+			snps,rd_osr_lmt = <16>;
+			snps,blen = <0 0 0 0 16 0 0>;
+		};
+
+		emac0_mtl_rx: rx-queues-config {
+			snps,rx-queues-to-use = <8>;
+			snps,rx-sched-sp;
+
+			queue0 {
+				snps,dcb-algorithm;
+				snps,map-to-dma-channel = <0x0>;
+				snps,route-up;
+			};
+
+			queue1 {
+				snps,dcb-algorithm;
+				snps,map-to-dma-channel = <0x1>;
+				snps,route-ptp;
+			};
+
+			queue2 {
+				snps,avb-algorithm;
+				snps,map-to-dma-channel = <0x2>;
+				snps,route-avcp;
+			};
+
+			queue3 {
+				snps,avb-algorithm;
+				snps,map-to-dma-channel = <0x3>;
+				snps,priority = <0xc>;
+			};
+
+			queue4 {
+				snps,dcb-algorithm;
+				snps,map-to-dma-channel = <0x4>;
+			};
+
+			queue5 {
+				snps,dcb-algorithm;
+				snps,map-to-dma-channel = <0x5>;
+			};
+
+			queue6 {
+				snps,dcb-algorithm;
+				snps,map-to-dma-channel = <0x6>;
+			};
+
+			queue7 {
+				snps,dcb-algorithm;
+				snps,map-to-dma-channel = <0x7>;
+			};
+		};
+
+		emac0_mtl_tx: tx-queues-config {
+			snps,tx-queues-to-use = <8>;
+
+			queue0 { snps,dcb-algorithm; };
+			queue1 { snps,dcb-algorithm; };
+			queue2 { snps,dcb-algorithm; };
+			queue3 { snps,dcb-algorithm; };
+			queue4 { snps,dcb-algorithm; };
+			queue5 { snps,dcb-algorithm; };
+			queue6 { snps,dcb-algorithm; };
+			queue7 { snps,dcb-algorithm; };
+		};
+	};
+
+	xpcs0: xpcs@1a14000 {
+		compatible = "qcom,nord-dw-xpcs";
+		reg = <0x0 0x01a14000 0x0 0x5100>;
+		reg-names = "direct";
+		reg-io-width = <4>;
+		clocks = <&segcc SE_GCC_EMAC0_CNOC_APB_CLK>;
+		clock-names = "csr";
+		power-domains = <&segcc SE_GCC_EMAC0_GDSC>;
+	};
+
+	ethernet1: ethernet@1a80000 {
+		compatible = "qcom,nord-ethqos";
+		reg = <0x0 0x01a80000 0x0 0x14000>,
+		      <0x0 0x01aff000 0x0 0x1000>;
+		reg-names = "stmmaceth", "rgmii";
+		interrupts = <GIC_SPI 820 IRQ_TYPE_LEVEL_HIGH>,
+			     <GIC_SPI 512 IRQ_TYPE_LEVEL_HIGH>;
+		interrupt-names = "macirq", "eth_lpi";
+		clocks = <&segcc SE_GCC_EMAC1_AXI_CLK>,
+			 <&segcc SE_GCC_EMAC1_CNOC_APB_CLK>,
+			 <&segcc SE_GCC_EMAC1_PTP_CLK>,
+			 <&segcc SE_GCC_EMAC1_PHY_AUX_CLK>,
+			 <&segcc SE_GCC_EEE_EMAC1_CLK>;
+		clock-names = "stmmaceth", "pclk", "ptp_ref", "phyaux", "eee";
+		resets = <&segcc SE_GCC_EMAC1_BCR>;
+		power-domains = <&segcc SE_GCC_EMAC1_GDSC>;
+		iommus = <&apps_smmu_2 0x11c1 0x8>,
+			 <&apps_smmu_2 0x11c2 0x1>,
+			 <&apps_smmu_2 0x11c3 0x1>,
+			 <&apps_smmu_2 0x11c4 0x3>,
+			 <&apps_smmu_2 0x11c5 0x3>,
+			 <&apps_smmu_2 0x11c6 0x3>,
+			 <&apps_smmu_2 0x11c7 0x3>,
+			 <&apps_smmu_2 0x11c8 0x2>,
+			 <&apps_smmu_2 0x11c9 0x8>,
+			 <&apps_smmu_2 0x11ca 0x2>;
+		pcs-handle = <&xpcs1>;
+		phys = <&serdes1>;
+		phy-names = "serdes";
+		dma-coherent;
+		snps,tso;
+		snps,pbl = <16>;
+		rx-fifo-depth = <98304>;
+		tx-fifo-depth = <98304>;
+		snps,axi-config = <&emac1_axi_setup>;
+		snps,mtl-rx-config = <&emac1_mtl_rx>;
+		snps,mtl-tx-config = <&emac1_mtl_tx>;
+		status = "disabled";
+
+		emac1_axi_setup: stmmac-axi-config {
+			snps,wr_osr_lmt = <16>;
+			snps,rd_osr_lmt = <16>;
+			snps,blen = <0 0 0 0 16 0 0>;
+		};
+
+		emac1_mtl_rx: rx-queues-config {
+			snps,rx-queues-to-use = <8>;
+			snps,rx-sched-sp;
+
+			queue0 {
+				snps,dcb-algorithm;
+				snps,map-to-dma-channel = <0x0>;
+				snps,route-up;
+			};
+
+			queue1 {
+				snps,dcb-algorithm;
+				snps,map-to-dma-channel = <0x1>;
+				snps,route-ptp;
+			};
+
+			queue2 {
+				snps,avb-algorithm;
+				snps,map-to-dma-channel = <0x2>;
+				snps,route-avcp;
+			};
+
+			queue3 {
+				snps,avb-algorithm;
+				snps,map-to-dma-channel = <0x3>;
+				snps,priority = <0xc>;
+			};
+
+			queue4 {
+				snps,dcb-algorithm;
+				snps,map-to-dma-channel = <0x4>;
+			};
+
+			queue5 {
+				snps,dcb-algorithm;
+				snps,map-to-dma-channel = <0x5>;
+			};
+
+			queue6 {
+				snps,dcb-algorithm;
+				snps,map-to-dma-channel = <0x6>;
+			};
+
+			queue7 {
+				snps,dcb-algorithm;
+				snps,map-to-dma-channel = <0x7>;
+			};
+		};
+
+		emac1_mtl_tx: tx-queues-config {
+			snps,tx-queues-to-use = <8>;
+
+			queue0 { snps,dcb-algorithm; };
+			queue1 { snps,dcb-algorithm; };
+			queue2 { snps,dcb-algorithm; };
+			queue3 { snps,dcb-algorithm; };
+			queue4 { snps,dcb-algorithm; };
+			queue5 { snps,dcb-algorithm; };
+			queue6 { snps,dcb-algorithm; };
+			queue7 { snps,dcb-algorithm; };
+		};
+	};
+
+	xpcs1: xpcs@1a94000 {
+		compatible = "qcom,nord-dw-xpcs";
+		reg = <0x0 0x01a94000 0x0 0x5100>;
+		reg-names = "direct";
+		reg-io-width = <4>;
+		clocks = <&segcc SE_GCC_EMAC1_CNOC_APB_CLK>;
+		clock-names = "csr";
+		power-domains = <&segcc SE_GCC_EMAC1_GDSC>;
+	};
+
+	pcie_phy: phy@1b00000 {
+		compatible = "qcom,nord-qmp-gen5x16-pcie-phy";
+
+		reg = <0x0 0x01b00000 0x0 0x10000>,
+		      <0x0 0x01b10000 0x0 0x10000>,
+		      <0x0 0x01b20000 0x0 0x10000>,
+		      <0x0 0x01b30000 0x0 0x10000>;
+		reg-names = "port_a",
+			    "port_b",
+			    "port_c",
+			    "port_d";
+
+		clocks = <&gcc GCC_PCIE_A_PHY_AUX_CLK>,
+			 <&gcc GCC_PCIE_A_CFG_AHB_CLK>,
+			 <&tcsrcc TCSR_PCIE_CLKREF_EN>,
+			 <&gcc GCC_PCIE_A_PHY_RCHNG_CLK>,
+			 <&gcc GCC_PCIE_A_PIPE_CLK>,
+			 <&gcc GCC_PCIE_B_PHY_AUX_CLK>,
+			 <&gcc GCC_PCIE_B_CFG_AHB_CLK>,
+			 <&gcc GCC_PCIE_B_PHY_RCHNG_CLK>,
+			 <&gcc GCC_PCIE_B_PIPE_CLK>,
+			 <&gcc GCC_PCIE_C_PHY_AUX_CLK>,
+			 <&gcc GCC_PCIE_C_CFG_AHB_CLK>,
+			 <&gcc GCC_PCIE_C_PHY_RCHNG_CLK>,
+			 <&gcc GCC_PCIE_C_PIPE_CLK>,
+			 <&gcc GCC_PCIE_D_PHY_AUX_CLK>,
+			 <&gcc GCC_PCIE_D_CFG_AHB_CLK>,
+			 <&gcc GCC_PCIE_D_PHY_RCHNG_CLK>,
+			 <&gcc GCC_PCIE_D_PIPE_CLK>;
+		clock-names = "aux_a",
+			      "cfg_ahb_a",
+			      "ref",
+			      "rchng_a",
+			      "pipe_a",
+			      "aux_b",
+			      "cfg_ahb_b",
+			      "rchng_b",
+			      "pipe_b",
+			      "aux_c",
+			      "cfg_ahb_c",
+			      "rchng_c",
+			      "pipe_c",
+			      "aux_d",
+			      "cfg_ahb_d",
+			      "rchng_d",
+			      "pipe_d";
+
+		assigned-clocks = <&gcc GCC_PCIE_A_PHY_RCHNG_CLK>,
+				  <&gcc GCC_PCIE_B_PHY_RCHNG_CLK>,
+				  <&gcc GCC_PCIE_C_PHY_RCHNG_CLK>,
+				  <&gcc GCC_PCIE_D_PHY_RCHNG_CLK>;
+		assigned-clock-rates = <100000000>,
+				       <100000000>,
+				       <100000000>,
+				       <100000000>;
+
+		power-domains = <&gcc GCC_PCIE_A_PHY_GDSC>,
+				<&gcc GCC_PCIE_B_PHY_GDSC>,
+				<&gcc GCC_PCIE_C_PHY_GDSC>,
+				<&gcc GCC_PCIE_D_PHY_GDSC>;
+		power-domain-names = "port_a",
+				     "port_b",
+				     "port_c",
+				     "port_d";
+
+		resets = <&gcc GCC_PCIE_A_PHY_COM_BCR>,
+			 <&gcc GCC_PCIE_A_NOCSR_COM_PHY_BCR>,
+			 <&gcc GCC_PCIE_B_PHY_COM_BCR>,
+			 <&gcc GCC_PCIE_B_NOCSR_COM_PHY_BCR>,
+			 <&gcc GCC_PCIE_C_PHY_COM_BCR>,
+			 <&gcc GCC_PCIE_C_NOCSR_COM_PHY_BCR>,
+			 <&gcc GCC_PCIE_D_PHY_COM_BCR>,
+			 <&gcc GCC_PCIE_D_NOCSR_COM_PHY_BCR>;
+		reset-names = "port_a",
+			      "port_a_nocsr",
+			      "port_b",
+			      "port_b_nocsr",
+			      "port_c",
+			      "port_c_nocsr",
+			      "port_d",
+			      "port_d_nocsr";
+
+		qcom,link-mode = <&tcsr 0x71050>;
+
+		#clock-cells = <1>;
+		clock-output-names = "pcie_a_pipe_clk",
+				     "pcie_b_pipe_clk",
+				     "pcie_c_pipe_clk",
+				     "pcie_d_pipe_clk";
+		#phy-cells = <1>;
+
+		status = "disabled";
+	};
+
 	pcie_cfg: interconnect@1ba0000 {
 		compatible = "qcom,nord-pcie-cfg";
 		reg = <0x0 0x01ba0000 0x0 0x7200>;
@@ -1932,6 +2262,22 @@ usb_1_hsphy: phy@88eb000 {
 		status = "disabled";
 	};
 
+	serdes0: phy@88f8000 {
+		compatible = "qcom,nord-dwmac-sgmii-phy";
+		reg = <0x0 0x088f8000 0x0 0x4000>;
+		clocks = <&tcsrcc TCSR_UX_SGMII_0_CLKREF_EN>;
+		clock-names = "sgmi_ref";
+		#phy-cells = <0>;
+	};
+
+	serdes1: phy@88fc000 {
+		compatible = "qcom,nord-dwmac-sgmii-phy";
+		reg = <0x0 0x088fc000 0x0 0x4000>;
+		clocks = <&tcsrcc TCSR_UX_SGMII_1_CLKREF_EN>;
+		clock-names = "sgmi_ref";
+		#phy-cells = <0>;
+	};
+
 	negcc: clock-controller@8900000 {
 		compatible = "qcom,nord-negcc";
 		reg = <0x0 0x08900000 0x0 0xf4200>;
diff --git a/arch/arm64/boot/dts/qcom/nord-ride-embedded.dts b/arch/arm64/boot/dts/qcom/nord-ride-embedded.dts
index 0811dcc1c2ed..fff3a3d53f9c 100644
--- a/arch/arm64/boot/dts/qcom/nord-ride-embedded.dts
+++ b/arch/arm64/boot/dts/qcom/nord-ride-embedded.dts
@@ -1042,3 +1042,43 @@ &usb_2_hsphy {
 
 	status = "okay";
 };
+
+&serdes0 {
+	vdda-0p9-supply = <&vreg_l1h_0p9>;
+	vdda-1p2-supply = <&vreg_l2h_1p2>;
+};
+
+&serdes1 {
+	vdda-0p9-supply = <&vreg_l1h_0p9>;
+	vdda-1p2-supply = <&vreg_l2h_1p2>;
+};
+
+&ethernet0 {
+	phy-mode = "usxgmii";
+	interconnects = <&hscnoc MASTER_APPSS_PROC QCOM_ICC_TAG_ALWAYS
+			 &config_noc SLAVE_PS_ETH_0 QCOM_ICC_TAG_ALWAYS>,
+			<&aggre2_noc_tile MASTER_EMAC_0 QCOM_ICC_TAG_ALWAYS
+			 &mc_virt SLAVE_EBI1 QCOM_ICC_TAG_ALWAYS>;
+	interconnect-names = "cpu-mac", "mac-mem";
+	status = "okay";
+
+	fixed-link {
+		speed = <10000>;
+		full-duplex;
+	};
+};
+
+&ethernet1 {
+	phy-mode = "usxgmii";
+	interconnects = <&hscnoc MASTER_APPSS_PROC QCOM_ICC_TAG_ALWAYS
+			 &config_noc SLAVE_PS_ETH_1 QCOM_ICC_TAG_ALWAYS>,
+			<&aggre2_noc_tile MASTER_EMAC_1 QCOM_ICC_TAG_ALWAYS
+			 &mc_virt SLAVE_EBI1 QCOM_ICC_TAG_ALWAYS>;
+	interconnect-names = "cpu-mac", "mac-mem";
+	status = "okay";
+
+	fixed-link {
+		speed = <10000>;
+		full-duplex;
+	};
+};
