From 8b53f56192ac1136bf65a637c1958bcad3985595 Mon Sep 17 00:00:00 2001
From: Mohammad Rafi Shaik <mohammad.rafi.shaik@oss.qualcomm.com>
Date: Tue, 13 Oct 2026 11:57:42 +0530
Subject: [PATCH] FIXUP: arm64: dts: qcom: nord-ride-embedded: Fix Audio
 capture issue

Backport the topic branch fixes for audio capture. V1 included the Audio
DT changes. Since the upstream audio driver has been updated to use QAIF
DAI IDs, align the DT accordingly to fix audio capture.

Signed-off-by: Mohammad Rafi Shaik <mohammad.rafi.shaik@oss.qualcomm.com>
Upstream-Status: Pending
---
 .../boot/dts/qcom/nord-ride-embedded.dts      | 104 ++++++++++--------
 arch/arm64/boot/dts/qcom/nord-rrd.dts         | 104 ++++++++++--------
 2 files changed, 118 insertions(+), 90 deletions(-)

diff --git a/arch/arm64/boot/dts/qcom/nord-ride-embedded.dts b/arch/arm64/boot/dts/qcom/nord-ride-embedded.dts
index 6f38a3c23c20..cc4233d833c1 100644
--- a/arch/arm64/boot/dts/qcom/nord-ride-embedded.dts
+++ b/arch/arm64/boot/dts/qcom/nord-ride-embedded.dts
@@ -56,6 +56,58 @@ bi_tcxo_ao_div2: bi-tcxo-ao-div2-clk {
 		};
 	};
 
+	sound {
+		compatible = "qcom,nord-sndcard";
+		model = "NORD-RIDE";
+
+		pinctrl-0 = <&aud_intfc8_mi2s_active>;
+		pinctrl-names = "default";
+
+		aud-intfc8-tdm-playback-dai-link {
+			link-name = "PCM1681 Playback";
+
+			codec {
+				dai-tdm-slot-num = <8>;
+				dai-tdm-slot-width = <32>;
+				dai-tdm-slot-rx-mask = <1 1>;
+				sound-dai = <&pcm1681>;
+			};
+
+			cpu {
+				dai-tdm-slot-num = <8>;
+				dai-tdm-slot-width = <32>;
+				dai-tdm-slot-tx-mask = <1 1>;
+				sound-dai = <&q6apmbedai AIF_TDM_RX_8>;
+			};
+
+			platform {
+				sound-dai = <&q6apm>;
+			};
+		};
+
+		aud-intfc8-tdm-capture-dai-link {
+			link-name = "ADAU1979 Capture";
+
+			codec {
+				dai-tdm-slot-num = <8>;
+				dai-tdm-slot-width = <32>;
+				dai-tdm-slot-rx-mask = <1 1>;
+				sound-dai = <&adau1979>;
+			};
+
+			cpu {
+				dai-tdm-slot-num = <8>;
+				dai-tdm-slot-width = <32>;
+				dai-tdm-slot-rx-mask = <1 1>;
+				sound-dai = <&q6apmbedai AIF_TDM_TX_8>;
+			};
+
+			platform {
+				sound-dai = <&q6apm>;
+			};
+		};
+	};
+
 	vreg_per_3p3: regulator-per-3p3 {
 		compatible = "regulator-fixed";
 		regulator-name = "vreg_per_3p3";
@@ -161,46 +213,6 @@ vreg_pmu_pcie_1p8: ldo9 {
 		};
 	};
 
-	sound {
-		compatible = "qcom,nord-ride-sndcard";
-		model = "NORD-RIDE-SX";
-
-		pinctrl-0 = <&aud_intfc8_mi2s_active>, <&aud_mclk0_mira_active>;
-		pinctrl-names = "default";
-
-		aud-intfc8-mi2s-playback-dai-link {
-			link-name = "PCM1681 Playback";
-
-			codec {
-				sound-dai = <&pcm1681>;
-			};
-
-			cpu {
-				sound-dai = <&q6apmbedai TERTIARY_MI2S_RX>;
-			};
-
-			platform {
-				sound-dai = <&q6apm>;
-			};
-		};
-
-		aud-intfc8-mi2s-capture-dai-link {
-			link-name = "ADAU1979 Capture";
-
-			codec {
-				sound-dai = <&adau1979>;
-			};
-
-			cpu {
-				sound-dai = <&q6apmbedai TERTIARY_MI2S_TX>;
-			};
-
-			platform {
-				sound-dai = <&q6apm>;
-			};
-		};
-	};
-
 	dp0_connector: connector-dp0 {
 		compatible = "dp-connector";
 		label = "eDP0";
@@ -742,7 +754,6 @@ adau1979: adau1979@31 {
 		reg = <0x31>;
 
 		AVDD-supply = <&vreg_per_3p3>;
-		DVDD-supply = <&vreg_per_3p3>;
 		#sound-dai-cells = <0>;
 	};
 
@@ -751,6 +762,9 @@ pcm1681: pcm1681@4c {
 		compatible = "ti,pcm1681";
 		reg = <0x4c>;
 
+		pinctrl-0 = <&aud_mclk0_mira_active>;
+		pinctrl-names = "default";
+
 		clocks = <&q6prmcc LPASS_CLK_ID_MCLK_1 LPASS_CLK_ATTRIBUTE_COUPLE_NO>;
 		clock-names = "sck";
 		assigned-clocks = <&q6prmcc LPASS_CLK_ID_MCLK_1 LPASS_CLK_ATTRIBUTE_COUPLE_NO>;
@@ -896,14 +910,14 @@ &q6apmbedai {
 	#address-cells = <1>;
 	#size-cells = <0>;
 
-	dai@20 {
-		reg = <TERTIARY_MI2S_RX>;
+	dai@195 {
+		reg = <AIF_TDM_RX_8>;
 		clocks = <&q6prmcc LPASS_CLK_ID_QAIF_IF8_IBIT LPASS_CLK_ATTRIBUTE_COUPLE_NO>;
 		clock-names = "bclk";
 	};
 
-	dai@21 {
-		reg = <TERTIARY_MI2S_TX>;
+	dai@196 {
+		reg = <AIF_TDM_TX_8>;
 		clocks = <&q6prmcc LPASS_CLK_ID_QAIF_IF8_IBIT LPASS_CLK_ATTRIBUTE_COUPLE_NO>;
 		clock-names = "bclk";
 	};
